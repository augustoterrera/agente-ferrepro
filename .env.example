# Copiá a .env (desarrollo) o .env.prod (producción). El compose elige cuál con ENV_FILE
# (default .env): en prod → ENV_FILE=.env.prod docker compose --profile prod up -d

# Supabase (REST + service_role key). Único acceso a la DB: productos y chat_memory.
SUPABASE_URL=https://tu-supabase/
SUPABASE_SERVICE_KEY=eyJ...

# OpenAI: agente + embeddings de la query (mismo modelo que el catálogo: text-embedding-3-small).
OPENAI_API_KEY=sk-...
# AGENT_MODEL=gpt-4.1-mini

# Chatwoot
CHATWOOT_URL=https://tu-chatwoot/
CHATWOOT_ACCOUNT_ID=6
CHATWOOT_ASSIGNEE_ID=29
CHATWOOT_ACCESS_TOKEN=...
CHATWOOT_WEBHOOK_SECRET=...
# REQUIRE_WEBHOOK_SECRET=true   # prod: aborta el arranque si falta el secret
# /reset solo funciona cuando coinciden teléfono y conversation ID.
# CHAT_RESET_PHONE=5493815551234
# CHAT_RESET_CONVERSATION_ID=8

# Celery / Redis. El compose levanta su propio Redis y setea estas dos por environment.
# Para reusar el Redis de odranid: apuntá a OTRA db index (ej. /2 y /3) y evitás colisión de colas.
# REDIS_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Producción: el HTTPS/reverse-proxy lo da el Traefik del VPS. El dominio va en el LABEL de
# docker-compose.prod.yml (no acá). Ver DESPLIEGUE.md.
# En prod poné esto en true: si falta CHATWOOT_WEBHOOK_SECRET, el arranque aborta (no acepta POSTs sin firmar).
REQUIRE_WEBHOOK_SECRET=true

# Esta versión del agente requiere postgres/migrations/002_retargeting.sql aplicada en Supabase:
# además del retargeting, ahí viven el intake atómico y la recuperación durable del outbox.
#
# Retargeting: follow-up ÚNICO a leads que se colgaron a mitad de charla.
#
# Puesta en marcha, en dos pasos (no te saltees el primero):
#   1. RETARGETING_ENABLED=true + RETARGETING_DRY_RUN=true  → evalúa y redacta pero NO envía.
#      Dejalo unos días y revisá a quién elegiría y qué le escribiría:
#        curl -H "x-admin-token: $ADMIN_TOKEN" https://.../admin/retargeting-stats
#        docker compose logs worker_outbound | grep retargeting_simulado
#   2. Recién ahí RETARGETING_DRY_RUN=false. Lo simulado no quema conversaciones: las mismas
#      siguen siendo candidatas cuando prendés el envío real.
# RETARGETING_ENABLED=false
# RETARGETING_DRY_RUN=true
# El follow-up sale LO MÁS TARDE POSIBLE dentro de la ventana de 24h de Meta (≈23h después del
# último mensaje del cliente): se le da tiempo real a contestar solo antes de insistir. Si la
# ventana vence de madrugada, sale la noche anterior — es la última chance dentro del horario.
# RETARGETING_SAFETY_MARGIN_HOURS=1  # colchón contra el cierre de la ventana
# RETARGETING_MIN_SILENCE_HOURS=2    # piso: no escribirle a alguien recién atendido
# RETARGETING_DAILY_CAP=40           # techo de envíos por día (rolling 24h)
# RETARGETING_BATCH_LIMIT=25         # candidatos por corrida
# RETARGETING_SWEEP_MINUTES=20       # cada cuánto corre el sweep (el beat lo toma de acá)
# El horario de envío (Tucumán, de lunes a lunes de 8 a 22, feriados incluidos) está en
# app/retargeting.py: SEND_START / SEND_END.

# Token del endpoint /admin/retargeting-stats. Sin esto el endpoint responde 404.
# ADMIN_TOKEN=algo-largo-y-random

# Meta / WhatsApp Cloud API + Catalogo
META_ACCESS_TOKEN=EA...
META_PHONE_NUMBER_ID=1234567890
META_CATALOG_ID=1234567890
# META_GRAPH_VERSION=v23.0

# Alertas por Telegram (opcional). Sin estas dos, no envía nada. Avisa en fallos finales de
# tasks y excepciones no manejadas de la API. Probar: docker compose exec api python -m app.notifier "test"
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=-1001234567890
# ALERT_PROJECT=ferrepro
